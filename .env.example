# Copy to .env and fill in. Never commit .env. For Streamlit Cloud, run `python scripts/make_secrets.py` and paste
# .streamlit/secrets.toml into the app's Secrets.

# Required
ANTHROPIC_API_KEY=your-key-here
# Owner-only Admin page. Leave empty to remove the page entirely. Use a long random value.
ADMIN_PASSWORD=

# Model and agent loop (shipped default: Claude Haiku 5.5, low effort)
LLM_MODEL=claude-haiku-5-5
LLM_MAX_TOKENS=2000         # per model turn; thinking counts toward it
LLM_EFFORT=low              # low | medium | high (empty = model default)
LLM_TIMEOUT_S=30            # per API call
LLM_RETRIES=1               # one retry on timeouts, 429 and 5xx
MAX_AGENT_STEPS=6           # model turns per email

# Public demo protections
MAX_EMAIL_CHARS=2000
MAX_EMAILS_PER_SESSION=10
MAX_EMAILS_PER_DAY=150
LOG_MAX_ENTRIES=5000

# Cost estimates on the Admin page (USD per million tokens; Claude Haiku 5.5 prices)
PRICE_IN_PER_M=0.10
PRICE_OUT_PER_M=0.50

# Admin page
ADMIN_IDLE_MINUTES=30       # signs out after this long without activity
ALERT_ERROR_RATE=0.2
ALERT_MIN_EVENTS=5
ALERT_DAILY_COST_USD=1.00

# Optional
# SIM_TODAY=2026-11-02      # the synthetic world's "today"
# LOG_DIR=data/logs

# ---------- Project 4 (all optional: leave blank and the app runs exactly as before) ----------
# Persistent request log. Blank = temporary files that reset on restart.
# Neon/Postgres: postgresql://user:password@host/db?sslmode=require   Local file: sqlite:///data/logs.db
DATABASE_URL=
# Staff sign-in (unlocks reporting for review). Blank = Demo mode only. Use a different value from ADMIN_PASSWORD.
STAFF_PASSWORD=
STAFF_IDLE_MINUTES=30
# Log records older than this are deleted (daily, and by python scripts/retention.py)
RETENTION_DAYS=30
# Budgets shown on the Operations page (CI checks the same numbers in the eval harness)
BUDGET_P95_S=12.0
BUDGET_COST_PER_1000=2.00
# Kill switch: true stops every model call at once (visitors get a clear "paused" message)
KILL_SWITCH=false
